# Socket/room server configuration
PORT=8000
# Legacy name still supported by server.js for existing local setups.
SOCKET_PORT=8000

# Use CLIENT_URL for one frontend origin, or CLIENT_URLS for a comma-separated list.
CLIENT_URL=http://localhost:3000
# CLIENT_URLS=http://localhost:3000,https://your-domain.example

COOKIE_SECRET=change-me
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/whiteboard_db
